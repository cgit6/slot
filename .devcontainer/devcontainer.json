{
  "name": "Python Stable Env",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python / Jupyter
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-python.black-formatter",
        "ms-python.isort",

        // Code Runner（你要的）
        "formulahendry.code-runner",

        // 其他（可選）
        "esbenp.prettier-vscode",
        "monokai.theme-monokai-pro-vscode",
        "pkief.material-icon-theme"
      ],
      "settings": {
        // 讓 VS Code 預設就使用專案內的虛擬環境
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "python.formatting.provider": "black",

        // Python 檔用 Black（避免被 Prettier 抢走）
        "[python]": { "editor.defaultFormatter": "ms-python.black-formatter" },

        // ★ Code Runner 一定用 .venv、在 Terminal 跑、以檔案所在資料夾為工作目錄
        "code-runner.executorMap": {
          "python": "${workspaceFolder}/.venv/bin/python -u"
        },
        "code-runner.runInTerminal": true,
        "code-runner.fileDirectoryAsCwd": true,
        "code-runner.ignoreSelection": true,
        "code-runner.saveFileBeforeRun": true
      }
    }
  },

  // 可重複的初始化：有就用、沒有就建；並裝依賴與 Jupyter kernel
  "postCreateCommand": "if [ ! -d .venv ]; then python -m venv .venv; fi && .venv/bin/python -m pip install -U pip setuptools wheel && if [ -f requirements.lock.txt ]; then .venv/bin/pip install -r requirements.lock.txt; elif [ -f requirements.txt ]; then .venv/bin/pip install -r requirements.txt; fi && .venv/bin/python -m pip install -q ipykernel && .venv/bin/python -m ipykernel install --user --name=${PWD##*/}-venv --display-name \"Python (.venv)\"",

  "postStartCommand": "if [ -x .venv/bin/python ]; then echo Using: $(.venv/bin/python -c 'import sys;print(sys.executable)'); .venv/bin/python -V; fi",

  "mounts": [
    "source=pip-cache,target=/home/vscode/.cache/pip,type=volume"
  ],

  "remoteUser": "vscode"
}
