{
  "name": "Python Stable Env",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-python.black-formatter",
        "ms-python.isort",
        "formulahendry.code-runner",
        "esbenp.prettier-vscode",
        "monokai.theme-monokai-pro-vscode",
        "pkief.material-icon-theme"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "python.terminal.activateEnvironment": true,
        "[python]": { "editor.defaultFormatter": "ms-python.black-formatter" },
        "code-runner.executorMap": { "python": "${workspaceFolder}/.venv/bin/python -u" },
        "code-runner.runInTerminal": true,
        "code-runner.fileDirectoryAsCwd": true,
        "code-runner.ignoreSelection": true,
        "code-runner.saveFileBeforeRun": true
      }
    }
  },

  "containerEnv": { "PIP_CACHE_DIR": "/home/vscode/.cache/pip" },

  // （可選）若你已經在用 prebuild，把安裝移到 updateContent/onCreate，否則保留你原本的 postCreate 也可以
  "onCreateCommand": "if [ ! -d .venv ]; then python -m venv .venv; fi",
  "updateContentCommand": "bash -lc 'set -e; REQ=; [ -f requirements.lock.txt ] && REQ=requirements.lock.txt || { [ -f requirements.txt ] && REQ=requirements.txt; }; NEW=0; [ ! -d .venv ] && NEW=1; NEED=0; if [ -n \"$REQ\" ]; then NH=$(sha256sum \"$REQ\"|cut -d\" \" -f1); OH=$(cat .venv/.req.hash 2>/dev/null || true); [ \"$NH\" != \"$OH\" ] && NEED=1; fi; if [ $NEW -eq 1 ] || [ $NEED -eq 1 ]; then .venv/bin/python -m pip install -U pip setuptools wheel && [ -n \"$REQ\" ] && .venv/bin/pip install --prefer-binary -r \"$REQ\" && echo \"$NH\" > .venv/.req.hash; fi'",
  "postCreateCommand": ".venv/bin/python -m pip install -q ipykernel && .venv/bin/python -m ipykernel install --user --name=${PWD##*/}-venv --display-name \"Python (.venv)\"",

  "postStartCommand": "if [ -x .venv/bin/python ]; then echo Using: $(.venv/bin/python -c 'import sys;print(sys.executable)'); .venv/bin/python -V; fi",

  "mounts": [
    "source=pip-cache,target=/home/vscode/.cache/pip,type=volume"
  ],

  "remoteUser": "vscode"
}
